# Copy this file to .env.local and fill in values from your Firebase project settings
# (Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration).
# Without these, the app still works fully on-device, but live follow and
# email sign-in (accounts / "My Leagues" across devices) are disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
