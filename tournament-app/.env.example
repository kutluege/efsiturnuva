# Copy this file to .env.local and fill in values from your Firebase project settings
# (Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration).
# Without these, the app still works fully, but the live "follow with a code" feature is disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (https://www.emailjs.com) — used to email the Admin ID to the league
# creator. Without these, the app falls back to opening the user's own mail
# client (mailto:) with the Admin ID pre-filled.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
